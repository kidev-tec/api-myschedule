# Runtime — development | test | production
NODE_ENV=development
PORT=3200
CORS_ORIGINS=*

# Postgres (Supabase pooler em prod — senha com % → encode 1x: %25)
DATABASE_URL=postgres://postgres:dev@localhost:5432/agenva_dev
# Banco de testes (vitest força localhost:5433; ignore o Supabase do DATABASE_URL)
TEST_DATABASE_URL=postgres://postgres:dev@localhost:5433/minha_agenda_dev
# Migrations (npm run db:migrate) — use DIRECT_URL se o pooler falhar
DIRECT_URL=postgres://postgres:dev@localhost:5432/agenva_dev

# Firebase Admin (ID token em rotas autenticadas)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Google Calendar OAuth (RF-08)
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REDIRECT_URI=https://SEU_DOMINIO/v1/gcal/callback

# SHA-1 debug keystore (Firebase OAuth Android) — só referência local
# SHA1_DEBUG=

# Email (Resend) — sem RESEND_API_KEY = log-only
RESEND_API_KEY=
EMAIL_FROM=Agenva <noreply@seudominio.com>

# Rotas /v1/internal/* — unset → 503 fail-closed
INTERNAL_KEY=
